    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.9.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "undici": "8.10.0"
