{
  "name": "openclaw-telegram-ux",
  "version": "0.2.0-beta.2",
  "description": "Telegram task receipts, progress and controls through public OpenClaw plugin APIs",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "examples",
    "scripts/rollback.py"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.9.1"
    },
    "build": {
      "openclawVersion": "2026.9.1"
    },
    "install": {
      "minHostVersion": ">=2026.9.1"
    }
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "peerDependencies": {
    "openclaw": "2026.9.1"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/build-info.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run docs:check && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "docs:check": "node scripts/check-docs.mjs",
    "test:install": "node scripts/install-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.9.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "undici": "8.10.0",
    "typebox": "1.3.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pler1y/openclaw-telegram-ux.git"
  },
  "homepage": "https://github.com/pler1y/openclaw-telegram-ux",
  "bugs": {
    "url": "https://github.com/pler1y/openclaw-telegram-ux/issues"
  }
}
