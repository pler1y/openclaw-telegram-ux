{
  "name": "openclaw-telegram-ux",
  "version": "0.1.0-beta.1",
  "description": "Chinese Telegram task feedback for OpenClaw",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "docs/PUBLIC-API.md",
    "docs/COMPATIBILITY.md",
    "docs/DEPLOYMENT.md",
    "docs/FEATURES.md",
    "docs/TEST-REPORT.md",
    "scripts/rollback.py"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "engines": {
